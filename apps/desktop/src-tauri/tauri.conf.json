{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inversion-app",
  "version": "0.1.0",
  "identifier": "com.inversion.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Inversion · 反演推演",
        "width": 880,
        "height": 720,
        "minWidth": 600,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
