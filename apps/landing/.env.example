# DeepSeek API Key —— 必填
# 从 https://platform.deepseek.com/api_keys 申请
# ⚠️ 永远不要把真实 key 提交到 git，永远不要在公开聊天里贴出来
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_NEW_KEY_FROM_platform.deepseek.com

# 可选：覆盖默认模型
# deepseek-chat      (V3, 通用对话, 推荐 landing page chatbot)
# deepseek-reasoner  (R1, 推理模型, 决策推演场景效果更好但慢一倍)
# DEEPSEEK_MODEL=deepseek-chat

# 可选：覆盖 base URL（一般不需要改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
